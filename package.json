{
  "name": "skill-crucible",
  "version": "0.1.1",
  "description": "Evidence lab for agent skills: static checks, security scan, score, and verified badges for any SKILL.md",
  "type": "module",
  "types": "./src/index.d.ts",
  "bin": {
    "crucible": "bin/crucible.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "bin",
    "src",
    "action.yml",
    "SKILL.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "selfcheck": "node bin/crucible.js check test/fixtures/good-skill",
    "badge": "node bin/crucible.js check SKILL.md --format json -o crucible-report.json --badge badge.svg --fail-on none"
  },
  "keywords": [
    "agent-skills",
    "claude-code",
    "skill",
    "skll-md",
    "security",
    "prompt-injection",
    "linter",
    "static-analysis",
    "badge",
    "ai-agents",
    "supply-chain"
  ],
  "license": "MIT",
  "author": "Dikaaff (https://github.com/Dikaaff)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dikaaff/skill-crucible.git"
  },
  "homepage": "https://github.com/Dikaaff/skill-crucible#readme",
  "bugs": {
    "url": "https://github.com/Dikaaff/skill-crucible/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  }
}
